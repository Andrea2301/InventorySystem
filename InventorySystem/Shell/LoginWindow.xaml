<Window x:Class="InventorySystem.Shell.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        Title="InventorySystem — Acceso"
        Width="920" Height="570"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        FontFamily="Segoe UI"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Input field style for text -->
        <Style x:Key="LoginInput" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrushPrimaryBlue}"/>
        </Style>

        <!-- Input field style for password -->
        <Style x:Key="LoginPasswordInput" TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource BrushPrimaryBlue}"/>
        </Style>

        <!-- Modern Gradient Login Button -->
        <Style x:Key="LoginBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrandGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="11">
                            <Border.Effect>
                                <DropShadowEffect Color="#4359A8" BlurRadius="14" ShadowDepth="3" Opacity="0.32"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnSurface" Property="Background" Value="{StaticResource PrimaryBrandGradientHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnSurface" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window with Ambient Soft Shadow -->
    <Border CornerRadius="18"
            Background="{StaticResource BrushCardWhite}"
            BorderBrush="{StaticResource BrushBorderSubtle}"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#172033" BlurRadius="35" ShadowDepth="6" Opacity="0.22"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Left panel: Brand & Ambient Glassmorphism -->
                <ColumnDefinition Width="410"/>
                <!-- Right panel: Clean Interactive Form -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT: BRAND PANEL ================= -->
            <Border Grid.Column="0"
                    CornerRadius="18,0,0,18"
                    Background="{StaticResource SidebarBrandGradient}">
                <Grid>
                    <!-- Ambient decorative circles -->
                    <Ellipse Width="320" Height="320" HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-110,-90,0,0" Opacity="0.12">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#7C8EF3" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse Width="240" Height="240" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-70,-70" Opacity="0.10">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#5368B5" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="36">
                        <!-- Glassmorphic Emblem -->
                        <Border Width="76" Height="76" CornerRadius="22" HorizontalAlignment="Center"
                                Margin="0,0,0,20"
                                Background="#25FFFFFF"
                                BorderBrush="#40FFFFFF"
                                BorderThickness="1.5">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="2" Opacity="0.15"/>
                            </Border.Effect>
                            <fa:IconImage Icon="BoxesStacked" Foreground="White" Width="38" Height="38"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="INVST" Foreground="White" FontSize="30" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource LoginBrandSubtext}" Foreground="#C9D3EC" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0,4,0,26"/>

                        <!-- Subtle Divider -->
                        <Rectangle Height="1" Fill="#20FFFFFF" Margin="0,0,0,24"/>

                        <!-- Feature Badges with Glass Pills -->
                        <Border Background="#15FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1"
                                CornerRadius="9" Padding="12,7" Margin="0,0,0,10" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="ShieldHalved" Foreground="{StaticResource BrushPurpleAccent}" Width="15" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource LoginFeatureSecure}" Foreground="#E9EDF8" FontSize="12" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#15FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1"
                                CornerRadius="9" Padding="12,7" Margin="0,0,0,10" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="ChartLine" Foreground="{StaticResource BrushPurpleAccent}" Width="15" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource LoginFeatureAnalytics}" Foreground="#E9EDF8" FontSize="12" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#15FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1"
                                CornerRadius="9" Padding="12,7" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <fa:IconImage Icon="CashRegister" Foreground="{StaticResource BrushPurpleAccent}" Width="15" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource LoginFeaturePOS}" Foreground="#E9EDF8" FontSize="12" FontWeight="Medium"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= RIGHT: LOGIN FORM ================= -->
            <Border Grid.Column="1"
                    CornerRadius="0,18,18,0"
                    Background="{StaticResource BrushCardWhite}">
                <Grid>
                    <!-- Close button in top-right corner -->
                    <Button x:Name="BtnClose"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,14,14,0" Width="30" Height="30"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Click="BtnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBorder" Background="Transparent" CornerRadius="8">
                                    <fa:IconImage x:Name="closeIcon" Icon="Xmark" Foreground="{StaticResource BrushTextMuted}" Width="13"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBorder" Property="Background" Value="#FEE2E2"/>
                                        <Setter TargetName="closeIcon" Property="Foreground" Value="#DC2626"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <StackPanel VerticalAlignment="Center" Margin="52,0,52,0">
                        <TextBlock Text="{DynamicResource LoginWelcomeBack}"
                                   Foreground="{StaticResource BrushTitleText}"
                                   FontSize="26" FontWeight="Bold"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource LoginSignInSubtitle}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="13" Margin="0,0,0,32"/>

                        <!-- Username Field -->
                        <TextBlock Text="{DynamicResource LoginLabelUsername}"
                                   Foreground="{StaticResource BrushTitleText}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>
                        <Border x:Name="UsernameBorder"
                                Background="{StaticResource BrushSectionLilac}"
                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Height="46"
                                Margin="0,0,0,18">
                            <Grid>
                                <fa:IconImage Icon="User" Foreground="{StaticResource BrushSecondaryBlue}" Width="15"
                                              HorizontalAlignment="Left" Margin="14,0,0,0"/>
                                <TextBox x:Name="TxtUsername"
                                         Style="{StaticResource LoginInput}"
                                         Margin="42,0,14,0"
                                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="Input_KeyDown"/>
                            </Grid>
                        </Border>

                        <!-- Password Field -->
                        <TextBlock Text="{DynamicResource LoginLabelPassword}"
                                   Foreground="{StaticResource BrushTitleText}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Margin="0,0,0,7"/>
                        <Border x:Name="PasswordBorder"
                                Background="{StaticResource BrushSectionLilac}"
                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Height="46"
                                Margin="0,0,0,10">
                            <Grid>
                                <fa:IconImage Icon="Lock" Foreground="{StaticResource BrushSecondaryBlue}" Width="15"
                                              HorizontalAlignment="Left" Margin="14,0,0,0"/>
                                <PasswordBox x:Name="PwdPassword"
                                             Style="{StaticResource LoginPasswordInput}"
                                             Margin="42,0,14,0"
                                             KeyDown="Input_KeyDown"
                                             PasswordChanged="PwdPassword_PasswordChanged"/>
                            </Grid>
                        </Border>

                        <!-- Error Message Badge -->
                        <Border Background="#FEF2F2"
                                BorderBrush="#FECACA"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,0,10"
                                ToolTip="{Binding ErrorMessage}"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <fa:IconImage Grid.Column="0" Icon="CircleExclamation" Foreground="#DC2626" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="#B91C1C" FontSize="12"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <!-- Loading Indicator Bar -->
                        <Border Margin="0,0,0,6" Height="4" CornerRadius="2"
                                Background="{StaticResource PrimaryBrandGradient}"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>

                        <!-- Login Button -->
                        <Button x:Name="BtnLogin"
                                Style="{StaticResource LoginBtn}"
                                Height="46"
                                Content="{DynamicResource LoginButtonText}"
                                Command="{Binding LoginCommand}"
                                Margin="0,12,0,0"/>

                        <!-- Version Tag -->
                        <TextBlock Text="{DynamicResource LoginVersionTag}"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="11" HorizontalAlignment="Center" Margin="0,24,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
