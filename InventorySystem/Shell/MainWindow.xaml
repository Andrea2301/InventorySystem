<Window x:Class="InventorySystem.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InventorySystem"
        xmlns:viewModel="clr-namespace:InventorySystem.ViewModel"
        xmlns:Icons="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp" 
        xmlns:local1="clr-namespace:InventorySystem.Views"
        mc:Ignorable="d"
        Icon="../Assets/Img/modelado_multi.ico"
        Title="INVST - Inventory Management System" 
        Height="720" Width="1280"
        MinHeight="650" MinWidth="1050"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        Background="Transparent"  
        AllowsTransparency="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModel:HomeViewModel}">
            <local1:HomeView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:ClientViewModel}">
            <local1:ClientView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:ProductsViewModel}">
            <local1:ProductsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:SaleViewModel}">
            <local1:SaleView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:SalesHistoryViewModel}">
            <local1:SalesHistoryView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:SupplierViewModel}">
            <local1:SupplierView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:ReportsViewModel}">
            <local1:ReportsView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewModel:MaintenanceViewModel}">
            <local1:MaintenanceView/>
        </DataTemplate>

        <!-- Close button specialized hover -->
        <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource controlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FEE2E2"/>
                    <Setter Property="Foreground" Value="#DC2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Outer Window Border with Depth Shadow -->
    <Border CornerRadius="16"
            Background="{StaticResource BrushMainBg}"
            BorderBrush="{StaticResource BrushBorderSubtle}"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#172033" BlurRadius="30" ShadowDepth="4" Opacity="0.18"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Navigation Sidebar -->
                <ColumnDefinition Width="260"/>
                <!-- Main Workspace -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= SIDEBAR ================= -->
            <Border Grid.Column="0"
                    CornerRadius="16,0,0,16"
                    Background="{StaticResource SidebarBrandGradient}"
                    BorderThickness="0,0,1,0"
                    BorderBrush="#25FFFFFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Top Brand Header + Active Workspace Card -->
                        <RowDefinition Height="Auto"/>
                        <!-- Navigation Items -->
                        <RowDefinition Height="*"/>
                        <!-- Footer / User Profile & Sign Out -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TOP SECTION: BRAND HEADER & ACTIVE WORKSPACE -->
                    <StackPanel Grid.Row="0" Margin="16,18,16,10">
                        <!-- Brand Header -->
                        <Grid Margin="2,0,2,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Cloud Icon Badge -->
                            <Border Grid.Column="0" Width="38" Height="38"
                                    CornerRadius="10"
                                    Background="#1F2E70"
                                    BorderBrush="#35499A"
                                    BorderThickness="1">
                                <fa:IconImage Icon="Cloud" Foreground="#FFFFFF" Width="18" Height="18"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Inventory"
                                               Foreground="#FFFFFF"
                                               FontSize="16.5"
                                               FontWeight="Bold"/>
                                    <!-- Green Pulse Dot -->
                                    <Ellipse Width="7" Height="7"
                                             Fill="#22C55E"
                                             VerticalAlignment="Center"
                                             Margin="8,1,0,0"/>
                                </StackPanel>
                                <TextBlock Text="DESKTOP WORKSPACE"
                                           Foreground="{StaticResource BrushSidebarTextMuted}"
                                           FontSize="9.5"
                                           FontWeight="Bold"
                                           Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- ACTIVE WORKSPACE CARD -->
                        <Border Background="{StaticResource BrushSidebarCard}"
                                BorderBrush="{StaticResource BrushSidebarCardBorder}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Cube Badge -->
                                <Border Grid.Column="0" Width="28" Height="28"
                                        CornerRadius="7"
                                        Background="#28387F"
                                        VerticalAlignment="Center">
                                    <fa:IconImage Icon="Cube" Foreground="{StaticResource BrushSidebarTextMuted}" Width="13" Height="13"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="ACTIVE WORKSPACE"
                                               FontSize="8.5"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource BrushSidebarTextMuted}"/>
                                    <TextBlock Text="My Inventory"
                                               FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFFFF"
                                               Margin="0,1,0,0"/>
                                </StackPanel>

                                <fa:IconImage Grid.Column="2" Icon="ChevronDown" Foreground="{StaticResource BrushSidebarTextMuted}" Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- NAVIGATION MENU ITEMS -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,4,0,10">

                            <!-- Section: OPERATIONS -->
                            <TextBlock Text="OPERATIONS"
                                       Foreground="{StaticResource BrushSidebarTextMuted}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="22,10,22,6"/>

                            <RadioButton Style="{StaticResource MenuBottons}"
                                         GroupName="MainMenu"
                                         IsChecked="True"
                                         Command="{Binding ShowHomeViewCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="ChartLine" Style="{StaticResource MenuButtonIcon}"/>
                                    <TextBlock Text="Dashboard" Style="{StaticResource ButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource MenuBottons}"
                                         GroupName="MainMenu"
                                         Command="{Binding ShowProductsViewCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="BoxesStacked" Style="{StaticResource MenuButtonIcon}"/>
                                    <TextBlock Text="Products" Style="{StaticResource ButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource MenuBottons}"
                                         GroupName="MainMenu"
                                         Command="{Binding ShowClientViewCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="Users" Style="{StaticResource MenuButtonIcon}"/>
                                    <TextBlock Text="Clients" Style="{StaticResource ButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource MenuBottons}"
                                         GroupName="MainMenu"
                                         Command="{Binding ShowSaleViewCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="CashRegister" Style="{StaticResource MenuButtonIcon}"/>
                                    <TextBlock Text="Sales" Style="{StaticResource ButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource MenuBottons}"
                                         GroupName="MainMenu"
                                         Command="{Binding ShowSalesHistoryViewCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="ClockRotateLeft" Style="{StaticResource MenuButtonIcon}"/>
                                    <TextBlock Text="Sales History" Style="{StaticResource ButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                            <!-- Section: MANAGEMENT -->
                            <TextBlock Text="MANAGEMENT"
                                       Foreground="{StaticResource BrushSidebarTextMuted}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Margin="22,18,22,6"/>

                            <RadioButton Style="{StaticResource MenuBottons}"
                                         GroupName="MainMenu"
                                         Command="{Binding ShowSupplierViewCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="TruckFast" Style="{StaticResource MenuButtonIcon}"/>
                                    <TextBlock Text="Suppliers" Style="{StaticResource ButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource MenuBottons}"
                                         GroupName="MainMenu"
                                         Command="{Binding ShowReportsViewCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="ChartPie" Style="{StaticResource MenuButtonIcon}"/>
                                    <TextBlock Text="Reports" Style="{StaticResource ButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Style="{StaticResource MenuBottons}"
                                         GroupName="MainMenu"
                                         Command="{Binding ShowMaintenanceViewCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <fa:IconImage Icon="Gear" Style="{StaticResource MenuButtonIcon}"/>
                                    <TextBlock Text="Settings" Style="{StaticResource ButtonText}"/>
                                </StackPanel>
                            </RadioButton>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- SIDEBAR FOOTER (User Profile & Sign Out) -->
                    <Border Grid.Row="2"
                            Margin="12,8,12,14"
                            Padding="10,8"
                            CornerRadius="10"
                            Background="{StaticResource BrushSidebarCard}"
                            BorderBrush="{StaticResource BrushSidebarCardBorder}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Warm Amber Avatar Badge: "AD" -->
                            <Border Grid.Column="0" Width="32" Height="32"
                                    CornerRadius="16"
                                    Background="#D97706">
                                <TextBlock Text="AD"
                                           Foreground="#FFFFFF"
                                           FontWeight="Bold"
                                           FontSize="11.5"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="admin"
                                           Foreground="#FFFFFF"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Admin"
                                           Foreground="{StaticResource BrushSidebarTextMuted}"
                                           FontSize="10.5"/>
                            </StackPanel>

                            <!-- Sign Out Button -->
                            <Button Grid.Column="2"
                                    ToolTip="Cerrar Sesión"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="BtnSignOut_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="SignOutBorder" Background="Transparent" CornerRadius="6" Padding="6,4">
                                            <fa:IconImage x:Name="SignOutIcon" Icon="ArrowRightFromBracket" Foreground="{StaticResource BrushSidebarTextMuted}" Width="13" Height="13"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SignOutBorder" Property="Background" Value="#25FFFFFF"/>
                                                <Setter TargetName="SignOutIcon" Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= MAIN WORKSPACE ================= -->
            <Border Grid.Column="1"
                    CornerRadius="0,16,16,0"
                    Background="{StaticResource BrushMainBg}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Top Draggable Bar & Window Controls -->
                        <RowDefinition Height="42"/>
                        <!-- Module Breadcrumb / Header Bar -->
                        <RowDefinition Height="56"/>
                        <!-- Active Module View Content -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TOP DRAGGABLE CONTROL BAR -->
                    <Grid Grid.Row="0"
                          x:Name="ControlBar"
                          Background="Transparent"
                          MouseLeftButtonDown="ControlBar_MouseLeftButtonDown"
                          MouseEnter="ControlBar_MouseEnter">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Window Controls (Minimize, Maximize, Close) -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                            <Button x:Name="Btn_Minimize"
                                    Style="{StaticResource controlButton}"
                                    ToolTip="Minimizar"
                                    Click="Btn_Minimize_Click">
                                <fa:IconImage Icon="WindowMinimize" Style="{StaticResource controlButtonIcon}"/>
                            </Button>

                            <Button x:Name="Btn_Maximize"
                                    Style="{StaticResource controlButton}"
                                    ToolTip="Maximizar"
                                    Click="Btn_Maximize_Click">
                                <fa:IconImage Icon="Square" Style="{StaticResource controlButtonIcon}"/>
                            </Button>

                            <Button x:Name="Btn_Close"
                                    Style="{StaticResource CloseWindowButton}"
                                    ToolTip="Cerrar"
                                    Click="Btn_Close_Click">
                                <fa:IconImage Icon="Xmark" Style="{StaticResource controlButtonIcon}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- MODULE HEADER / BREADCRUMB BAR -->
                    <Border Grid.Row="1"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource BrushBorderSubtle}"
                            Padding="28,0,28,0"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Current Module Title & Icon -->
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,0,8">
                                <!-- Glassmorphic Icon Badge -->
                                <Border Width="38" Height="38"
                                        CornerRadius="10"
                                        Background="{StaticResource BrushSectionLilac}"
                                        BorderBrush="#D5DEF5"
                                        BorderThickness="1">
                                    <fa:IconImage Icon="{Binding IconChar}"
                                                  Foreground="{StaticResource BrushPrimaryBlue}"
                                                  Height="18"
                                                  Width="18"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Caption}"
                                               Foreground="{StaticResource BrushTitleText}"
                                               FontSize="18"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Panel de Administración y Control"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               FontSize="11.5"
                                               Margin="0,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- MODULE VIEW CONTAINER -->
                    <Grid Grid.Row="2" Margin="14,10,14,14">
                        <ContentControl Content="{Binding CurrentChildView}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
