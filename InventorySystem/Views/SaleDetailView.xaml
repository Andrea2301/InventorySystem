<Window x:Class="InventorySystem.Views.SaleDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        xmlns:local="clr-namespace:InventorySystem.Views"
        mc:Ignorable="d" 
        Title="Sale Details" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent">
    
    <Border Background="{StaticResource BrushCardWhite}" CornerRadius="18" Margin="10" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" TextElement.FontFamily="Segoe UI">
        <Border.Effect>
            <DropShadowEffect Color="#202C47" BlurRadius="28" ShadowDepth="6" Opacity="0.18"/>
        </Border.Effect>
        
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title -->
                <RowDefinition Height="Auto"/> <!-- Sale Info -->
                <RowDefinition Height="*"/>    <!-- Items List -->
                <RowDefinition Height="Auto"/> <!-- Summary -->
                <RowDefinition Height="Auto"/> <!-- Footer button -->
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource BrushSectionLilac}" Margin="0,0,12,0">
                            <fa:IconImage Icon="Receipt" Foreground="{StaticResource BrushPrimaryBlue}" Width="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Sale Transaction Breakdown" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTitleText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Click="Close_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6">
                        <fa:IconImage Icon="Times" Width="16" Foreground="{StaticResource BrushSecondaryBlue}"/>
                    </Button>
                </Grid>
            </StackPanel>

            <!-- Sale Info -->
            <Border Grid.Row="1" Background="{StaticResource BrushSectionLilac}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ORDER NUMBER" Foreground="{StaticResource BrushSecondaryBlue}" FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Id, StringFormat='#{0}'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTitleText}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="SALE DATE" Foreground="{StaticResource BrushSecondaryBlue}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding SaleDate, StringFormat='dd/MM/yyyy HH:mm'}" FontSize="14" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Items List -->
            <DataGrid Grid.Row="2" ItemsSource="{Binding SaleDetails}" 
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False" 
                      IsReadOnly="True"
                      Background="Transparent"
                      BorderThickness="0"
                      GridLinesVisibility="None"
                      RowHeight="38"
                      HeadersVisibility="Column">
                
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource BrushSectionLilac}"/>
                        <Setter Property="Foreground" Value="{StaticResource BrushTitleText}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}"/>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product" Binding="{Binding Product.Name}" Width="*"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
                    <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=C}" Width="100"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, StringFormat=C}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushPrimaryBlue}"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Summary -->
            <StackPanel Grid.Row="3" Margin="0,15,0,0">
                <Separator Background="{StaticResource BrushBorderSubtle}" Margin="0,0,0,15"/>
                <Grid>
                    <TextBlock Text="Total Amount" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTitleText}"/>
                    <TextBlock Text="{Binding TotalAmount, StringFormat=C}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryBlue}" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>

            <!-- Footer -->
            <Button Grid.Row="4" Content="Back to History" Click="Close_Click"
                    Background="{StaticResource PrimaryBrandGradient}" Foreground="White" 
                    Height="42" Margin="0,20,0,0" 
                    BorderThickness="0" FontWeight="SemiBold" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
