<Window x:Class="InventorySystem.Views.SupplierFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        xmlns:helpers="clr-namespace:InventorySystem.Helpers"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="610" Width="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI"
        Background="Transparent">

    <Border CornerRadius="14" Background="{StaticResource BrushCardWhite}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.18" Color="#172033"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/> <!-- Header -->
                <RowDefinition Height="*"/>  <!-- Form -->
                <RowDefinition Height="70"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="14,14,0,0" Background="{StaticResource PrimaryBrandGradient}">
                <Grid>
                    <TextBlock Text="{Binding Title}" 
                               Foreground="White" 
                               FontSize="19" 
                               FontWeight="Bold" 
                               VerticalAlignment="Center" 
                               Margin="20,0"/>

                    <Button HorizontalAlignment="Right" 
                            VerticalAlignment="Center" 
                            Margin="0,0,14,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding CancelCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <fa:IconImage Icon="Xmark" Foreground="White" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="25,12">
                <StackPanel>
                    
                    <!-- Status Toggle -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Estado del Proveedor:" VerticalAlignment="Center" Foreground="{StaticResource BrushTitleText}" FontWeight="SemiBold" Margin="0,0,15,0"/>
                        <CheckBox Style="{StaticResource ModernToggleSwitch}" 
                                  IsChecked="{Binding IsActive}" 
                                  Content="{Binding IsActive, Converter={StaticResource BooleanToStatusConverter}}"/>
                    </StackPanel>

                    <!-- Basic Info Section -->
                    <TextBlock Text="Basic Information" Foreground="#3F51B5" FontWeight="Bold" Margin="0,10,0,10"/>
                    
                    <TextBlock Text="Document Number" Foreground="#757575" Margin="0,5,0,2"/>
                    <TextBox Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ValidatingTextBox}" 
                             helpers:TextBoxBehavior.Restriction="Numeric"
                             Padding="5" Height="35"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="First Name" Foreground="#757575" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ValidatingTextBox}" 
                                     helpers:TextBoxBehavior.Restriction="Letters"
                                     Padding="5" Height="35"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Last Name" Foreground="#757575" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ValidatingTextBox}" 
                                     helpers:TextBoxBehavior.Restriction="Letters"
                                     Padding="5" Height="35"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Company Name" Foreground="#757575" Margin="0,10,0,2"/>
                    <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ValidatingTextBox}" 
                             helpers:TextBoxBehavior.Restriction="Letters"
                             Padding="5" Height="35"/>

                    <Separator Margin="0,20,0,10" Background="#F0F0F0"/>

                    <!-- Contact Section -->
                    <TextBlock Text="Contact Details" Foreground="#3F51B5" FontWeight="Bold" Margin="0,0,0,10"/>

                    <TextBlock Text="Email" Foreground="#757575" Margin="0,5,0,2"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ValidatingTextBox}" 
                             Padding="5" Height="35"/>

                    <TextBlock Text="Phone" Foreground="#757575" Margin="0,10,0,2"/>
                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ValidatingTextBox}" 
                             helpers:TextBoxBehavior.Restriction="Phone"
                             Padding="5" Height="35"/>

                    <TextBlock Text="Website" Foreground="#757575" Margin="0,10,0,2"/>
                    <TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ValidatingTextBox}" 
                             Padding="5" Height="35"/>

                    <TextBlock Text="Address" Foreground="#757575" Margin="0,10,0,2"/>
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ValidatingTextBox}" 
                             Padding="5" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    
                    <TextBlock Text="Category" Foreground="#757575" Margin="0,10,0,2"/>
                    <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ValidatingTextBox}" 
                             Padding="5" Height="35"/>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer Actions -->
            <Border Grid.Row="2" Background="{StaticResource BrushMainBg}" CornerRadius="0,0,14,14">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,22,0">
                    <Button Content="Cancelar" 
                            Width="110" Height="38" 
                            Margin="0,0,12,0"
                            Background="{StaticResource BrushSectionLilac}"
                            Foreground="{StaticResource BrushTitleText}"
                            BorderBrush="{StaticResource BrushBorderSubtle}"
                            BorderThickness="1"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Command="{Binding CancelCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="Guardar Proveedor" 
                            Width="145" Height="38"
                            Background="{StaticResource PrimaryBrandGradient}"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Command="{Binding SaveCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</Window>
