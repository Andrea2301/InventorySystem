<Window x:Class="InventorySystem.Views.ProductFormView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        xmlns:local="clr-namespace:InventorySystem.Views"
        xmlns:helpers="clr-namespace:InventorySystem.Helpers"
        mc:Ignorable="d" 
        Title="{Binding FormTitle}" Height="660" Width="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI"
        Background="Transparent">

    <Grid Background="Transparent">
        <Border BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="14" Margin="12" Background="{StaticResource BrushCardWhite}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.18" Color="#172033"/>
            </Border.Effect>
            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title -->
                    <RowDefinition Height="Auto"/> <!-- Image -->
                    <RowDefinition Height="*"/>    <!-- Form -->
                    <RowDefinition Height="Auto"/> <!-- Buttons -->
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Text="{Binding FormTitle}" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource BrushTitleText}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,20"/>

                <!-- Image Selection -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Width="120" Height="120" CornerRadius="60" BorderBrush="#E0E0E0" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <!-- Placeholder -->
                            <fa:IconImage Icon="BoxOpen" Foreground="#CCC" Width="50" Height="50" 
                                          Visibility="{Binding PreviewImage, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Visible}"/>
                            
                            <!-- Preview Image -->
                            <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <Button Content="Select Image" 
                            Command="{Binding SelectImageCommand}"
                            Margin="0,10,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Foreground="#3f51b5"/>
                </StackPanel>

                <!-- Form Fields -->
                <StackPanel Grid.Row="2">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Product Status:" VerticalAlignment="Center" Foreground="#666" Margin="0,0,15,0"/>
                        <CheckBox Style="{StaticResource ModernToggleSwitch}" 
                                  IsChecked="{Binding IsActive}" 
                                  Content="{Binding IsActive, Converter={StaticResource BooleanToStatusConverter}}"/>
                    </StackPanel>

                    <TextBlock Text="Name" Foreground="#666" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ValidatingTextBox}" 
                             helpers:TextBoxBehavior.Restriction="Letters"
                             Margin="0,0,0,15" Padding="5"/>

                    <TextBlock Text="Category" Foreground="#666" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ValidatingTextBox}"
                             helpers:TextBoxBehavior.Restriction="Letters"
                             Margin="0,0,0,15" Padding="5"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Price" Foreground="#666" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Price, StringFormat=N2, UpdateSourceTrigger=LostFocus}" 
                                     Style="{StaticResource ValidatingTextBox}"
                                     helpers:TextBoxBehavior.Restriction="Numeric"
                                     Margin="0,0,0,15" Padding="5"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Quantity" Foreground="#666" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ValidatingTextBox}"
                                     helpers:TextBoxBehavior.Restriction="Numeric"
                                     Margin="0,0,0,15" Padding="5"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Description" Foreground="#666" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                             Height="80" 
                             TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto" 
                             AcceptsReturn="True"
                             Margin="0,0,0,15" Padding="5"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="Cancelar" 
                            Command="{Binding CancelCommand}"
                            Background="{StaticResource BrushSectionLilac}" 
                            BorderBrush="{StaticResource BrushBorderSubtle}" 
                            BorderThickness="1"
                            Foreground="{StaticResource BrushTitleText}"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Margin="0,0,10,0"
                            Width="105" Height="36">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    
                    <Button Content="Guardar Producto" 
                            Command="{Binding SaveCommand}"
                            Background="{StaticResource PrimaryBrandGradient}" 
                            BorderThickness="0"
                            Foreground="White"
                            Cursor="Hand"
                            FontWeight="SemiBold"
                            Width="140" Height="36">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Window>
