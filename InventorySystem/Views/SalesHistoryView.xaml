<UserControl x:Class="InventorySystem.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:local="clr-namespace:InventorySystem.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">
    
    <Grid Background="{StaticResource BrushMainBg}" TextElement.FontFamily="Segoe UI">
        <Border Background="{StaticResource BrushCardWhite}" Margin="20" CornerRadius="20" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#202C47" BlurRadius="16" ShadowDepth="2" Opacity="0.06"/>
            </Border.Effect>
            <Grid Margin="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Title & Search -->
                    <RowDefinition Height="*"/>    <!-- Sales List -->
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource BrushSectionLilac}" Margin="0,0,14,0">
                            <fa:IconImage Icon="CalendarAlt" Foreground="{StaticResource BrushPrimaryBlue}" Width="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Sales History" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushTitleText}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border HorizontalAlignment="Right" Background="{StaticResource BrushSectionLilac}" CornerRadius="12" Width="350" Height="44" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                        <Grid>
                            <fa:IconImage Icon="Search" Foreground="{StaticResource BrushPrimaryBlue}" Width="16" HorizontalAlignment="Left" Margin="15,0"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     VerticalAlignment="Center" 
                                     BorderThickness="0" 
                                     Background="Transparent" 
                                     Margin="45,0,15,0"
                                     FontSize="14"
                                     Foreground="{StaticResource BrushTextPrimary}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- SALES GRID -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding Sales}" 
                          SelectedItem="{Binding SelectedSale}"
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          IsReadOnly="True"
                          Background="Transparent"
                          BorderThickness="0"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          RowHeight="56">
                    
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource BrushSectionLilac}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTitleText}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="15,10"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BrushBorderSubtle}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource BrushSectionLilac}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                                        <Border Padding="15,0" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order #" Binding="{Binding Id}" Width="100"/>
                        
                        <DataGridTemplateColumn Header="Date" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <fa:IconImage Icon="Clock" Width="12" Foreground="{StaticResource BrushSecondaryBlue}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding SaleDate, StringFormat='dd/MM/yyyy HH:mm'}" Foreground="{StaticResource BrushTextPrimary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Client" Binding="{Binding Client.FullName, FallbackValue='General Client'}" Width="*"/>
                        
                        <DataGridTemplateColumn Header="Amount" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalAmount, StringFormat=C}" FontWeight="Bold" Foreground="{StaticResource BrushPrimaryBlue}" FontSize="15"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Actions" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Margin="0,0,10,0" ToolTip="View Details"
                                                Command="{Binding DataContext.ViewDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource btnEdit}">
                                            <fa:IconImage Icon="Eye" Width="14" Height="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                        <Button ToolTip="Print Receipt"
                                                Command="{Binding DataContext.PrintReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource btnInfo}">
                                            <fa:IconImage Icon="Receipt" Width="14" Height="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
        <!-- LOADING OVERLAY -->
        <Grid Style="{StaticResource LoadingOverlay}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Control Style="{StaticResource LoadingSpinner}" HorizontalAlignment="Center"/>
                <TextBlock Text="Loading history..." Margin="0,10,0,0" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
