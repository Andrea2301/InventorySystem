<UserControl 
    x:Class="InventorySystem.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:InventorySystem.Views"
    xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    mc:Ignorable="d"
    FontFamily="Segoe UI">

    <Border Background="{StaticResource BrushMainBg}" CornerRadius="12">
        <Grid>
            <!-- Main Content Container with Margin -->
            <Grid Margin="20,16,20,16">
                <Grid.RowDefinitions>
                    <!-- Header Bar (Overview / Title / Action Button) -->
                    <RowDefinition Height="Auto"/>
                    <!-- 4 Twin KPI Cards -->
                    <RowDefinition Height="Auto"/>
                    <!-- Main Content (Recent Sales + Stock to Review) -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ================= 1. HEADER BAR ================= -->
                <Grid Grid.Row="0" Margin="4,0,4,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title & Breadcrumb -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="OVERVIEW"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="0,0,0,2"/>
                        <TextBlock Text="A quick look at your store's activity and inventory."
                                   FontSize="13"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Right Quick Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Seed Data / Demo Refresh Button -->
                        <Button Command="{Binding SeedDataCommand}"
                                ToolTip="Generar / Resetear Datos Demo"
                                Height="36" Width="36"
                                Margin="0,0,8,0"
                                Background="{StaticResource BrushCardWhite}"
                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                BorderThickness="1"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="9">
                                        <fa:IconImage Icon="Database" Foreground="#6366F1" Width="14" Height="14"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Refresh Button -->
                        <Button Command="{Binding RefreshCommand}"
                                ToolTip="Actualizar Dashboard"
                                Height="36" Width="36"
                                Margin="0,0,10,0"
                                Background="{StaticResource BrushCardWhite}"
                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                BorderThickness="1"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="9">
                                        <fa:IconImage Icon="RotateRight" Foreground="{StaticResource BrushTextMuted}" Width="14" Height="14"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- View Sales Pill Button (matching Sister Cloud App) -->
                        <Button Command="{Binding NavigateToHistoryCommand}"
                                Height="36"
                                Padding="14,0"
                                Background="{StaticResource BrushCardWhite}"
                                BorderBrush="{StaticResource BrushBorderSubtle}"
                                BorderThickness="1"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="BtnPill"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="9"
                                            Padding="{TemplateBinding Padding}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#172033" BlurRadius="8" ShadowDepth="1" Opacity="0.04"/>
                                        </Border.Effect>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="View sales"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTitleText}"
                                                       VerticalAlignment="Center"/>
                                            <fa:IconImage Icon="ArrowRight"
                                                          Foreground="{StaticResource BrushTitleText}"
                                                          Width="12" Height="12"
                                                          Margin="8,0,0,0"
                                                          VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="BtnPill" Property="Background" Value="#F8FAFC"/>
                                            <Setter TargetName="BtnPill" Property="BorderBrush" Value="#CBD5E1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ================= 2. 4 KPI CARDS ROW ================= -->
                <UniformGrid Columns="4" Grid.Row="1" Margin="0,0,0,16">
                    <!-- CARD 1: Total sales -->
                    <Border Background="{StaticResource BrushCardWhite}" 
                            BorderBrush="{StaticResource BrushBorderSubtle}" 
                            BorderThickness="1" 
                            CornerRadius="14" 
                            Margin="5" 
                            Padding="16">
                        <Border.Effect>
                            <DropShadowEffect Color="#172033" BlurRadius="12" ShadowDepth="2" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Lavender Icon Badge -->
                                <Border Grid.Column="0"
                                        Background="#EDE9FE"
                                        CornerRadius="9"
                                        Width="36" Height="36">
                                    <fa:IconImage Icon="BagShopping" Foreground="#7C3AED" Width="16" Height="16"/>
                                </Border>

                                <!-- ALL TIME Tag -->
                                <Border Grid.Column="2"
                                        Background="#F1F5F9"
                                        CornerRadius="6"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="ALL TIME" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="Total sales"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalSalesCount}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushTitleText}"
                                       Margin="0,4,0,2"/>
                            <TextBlock Text="Recorded transactions"
                                       FontSize="11.5"
                                       Foreground="{StaticResource BrushTextMuted}"/>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: Sales revenue -->
                    <Border Background="{StaticResource BrushCardWhite}" 
                            BorderBrush="{StaticResource BrushBorderSubtle}" 
                            BorderThickness="1" 
                            CornerRadius="14" 
                            Margin="5" 
                            Padding="16">
                        <Border.Effect>
                            <DropShadowEffect Color="#172033" BlurRadius="12" ShadowDepth="2" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Mint Green Icon Badge -->
                                <Border Grid.Column="0"
                                        Background="#DCFCE7"
                                        CornerRadius="9"
                                        Width="36" Height="36">
                                    <fa:IconImage Icon="DollarSign" Foreground="#16A34A" Width="16" Height="16"/>
                                </Border>

                                <!-- ALL TIME Tag -->
                                <Border Grid.Column="2"
                                        Background="#F1F5F9"
                                        CornerRadius="6"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="ALL TIME" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="Sales revenue"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SalesRevenueFormatted}"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushTitleText}"
                                       Margin="0,4,0,2"/>
                            <TextBlock Text="Total from recorded sales"
                                       FontSize="11.5"
                                       Foreground="{StaticResource BrushTextMuted}"/>
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: Inventory value -->
                    <Border Background="{StaticResource BrushCardWhite}" 
                            BorderBrush="{StaticResource BrushBorderSubtle}" 
                            BorderThickness="1" 
                            CornerRadius="14" 
                            Margin="5" 
                            Padding="16">
                        <Border.Effect>
                            <DropShadowEffect Color="#172033" BlurRadius="12" ShadowDepth="2" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Sky Blue Icon Badge -->
                                <Border Grid.Column="0"
                                        Background="#E0F2FE"
                                        CornerRadius="9"
                                        Width="36" Height="36">
                                    <fa:IconImage Icon="BoxesStacked" Foreground="#0284C7" Width="16" Height="16"/>
                                </Border>

                                <!-- CURRENT Tag -->
                                <Border Grid.Column="2"
                                        Background="#F1F5F9"
                                        CornerRadius="6"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="CURRENT" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="Inventory value"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding InventoryValueFormatted}"
                                       FontSize="23"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource BrushTitleText}"
                                       Margin="0,4,0,2"/>
                            <TextBlock Text="{Binding ProductsCountSubtitle}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource BrushTextMuted}"/>
                        </StackPanel>
                    </Border>

                    <!-- CARD 4: Stock alerts -->
                    <Border Background="{StaticResource BrushCardWhite}" 
                            BorderBrush="{StaticResource BrushBorderSubtle}" 
                            BorderThickness="1" 
                            CornerRadius="14" 
                            Margin="5" 
                            Padding="16">
                        <Border.Effect>
                            <DropShadowEffect Color="#172033" BlurRadius="12" ShadowDepth="2" Opacity="0.04"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Warm Amber Icon Badge -->
                                <Border Grid.Column="0"
                                        Background="#FEF3C7"
                                        CornerRadius="9"
                                        Width="36" Height="36">
                                    <fa:IconImage Icon="TriangleExclamation" Foreground="#D97706" Width="16" Height="16"/>
                                </Border>

                                <!-- ATTENTION Tag -->
                                <Border Grid.Column="2"
                                        Background="#FEF3C7"
                                        CornerRadius="6"
                                        Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="ATTENTION" FontSize="9.5" FontWeight="Bold" Foreground="#B45309"/>
                                </Border>
                            </Grid>

                            <TextBlock Text="Stock alerts"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CriticalStockCount}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#D97706"
                                       Margin="0,4,0,2"/>
                            <TextBlock Text="Products low or out of stock"
                                       FontSize="11.5"
                                       Foreground="{StaticResource BrushTextMuted}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- ================= 3. MAIN CONTENT (2 PANELS) ================= -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <!-- Left Panel: Recent Sales (Twin Design) -->
                        <ColumnDefinition Width="1.7*"/>
                        <!-- Right Panel: Stock to review (Twin Design) -->
                        <ColumnDefinition Width="1.1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: RECENT SALES CARD -->
                    <Border Grid.Column="0"
                            Background="{StaticResource BrushCardWhite}"
                            BorderBrush="{StaticResource BrushBorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Margin="5"
                            Padding="20">
                        <Border.Effect>
                            <DropShadowEffect Color="#172033" BlurRadius="14" ShadowDepth="2" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Title Header -->
                                <RowDefinition Height="Auto"/> <!-- Table Column Headers -->
                                <RowDefinition Height="*"/>    <!-- Data Rows List -->
                            </Grid.RowDefinitions>

                            <!-- Section Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                                <TextBlock Text="LATEST ACTIVITY"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock Text="Recent sales"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushTitleText}"
                                           Margin="0,2,0,1"/>
                                <TextBlock Text="Latest completed transactions across your store."
                                           FontSize="12"
                                           Foreground="{StaticResource BrushTextMuted}"/>
                            </StackPanel>

                            <!-- Table Column Headers -->
                            <Border Grid.Row="1"
                                    BorderBrush="{StaticResource BrushBorderSubtle}"
                                    BorderThickness="0,1,0,1"
                                    Padding="4,8"
                                    Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.8*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="CLIENT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}"/>
                                    <TextBlock Grid.Column="1" Text="DATE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}"/>
                                    <TextBlock Grid.Column="2" Text="PAYMENT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}"/>
                                    <TextBlock Grid.Column="3" Text="TOTAL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                                </Grid>
                            </Border>

                            <!-- Sales List -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RecentSales}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="4,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.8*"/> <!-- Client -->
                                                        <ColumnDefinition Width="1.2*"/> <!-- Date -->
                                                        <ColumnDefinition Width="1.1*"/> <!-- Payment -->
                                                        <ColumnDefinition Width="1.2*"/> <!-- Total -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Action -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Client Name & Avatar -->
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="32" Height="32"
                                                                CornerRadius="16"
                                                                Background="#EEF2FF"
                                                                Margin="0,0,10,0">
                                                            <fa:IconImage Icon="User" Foreground="#4F46E5" Width="13" Height="13"/>
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Client.FullName, FallbackValue='Dairo ospino'}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource BrushTitleText}"
                                                                       FontSize="13"/>
                                                            <TextBlock Text="{Binding Client.Email, FallbackValue='Cliente'}"
                                                                       FontSize="11"
                                                                       Foreground="{StaticResource BrushTextMuted}"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <!-- Date -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding SaleDate, StringFormat='{}{0:MM/dd/yyyy}'}"
                                                               FontSize="12.5"
                                                               Foreground="{StaticResource BrushTextMuted}"
                                                               VerticalAlignment="Center"/>

                                                    <!-- Payment Badge -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <Border Background="#F1F5F9"
                                                                CornerRadius="6"
                                                                Padding="8,3"
                                                                HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding PaymentMethod, FallbackValue='Cash'}"
                                                                       FontSize="11.5"
                                                                       FontWeight="Medium"
                                                                       Foreground="#475569"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Total Amount -->
                                                    <TextBlock Grid.Column="3"
                                                               Text="{Binding TotalAmount, StringFormat='{}COP{0:N0}'}"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource BrushTitleText}"
                                                               FontSize="13.5"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,12,0"/>

                                                    <!-- Action / Receipt -->
                                                    <Button Grid.Column="4"
                                                            Command="{Binding DataContext.OpenReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Ver Recibo / Factura"
                                                            Height="28" Width="28"
                                                            Background="#F8FAFC"
                                                            BorderBrush="{StaticResource BrushBorderSubtle}"
                                                            BorderThickness="1"
                                                            Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}"
                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                                        CornerRadius="7">
                                                                    <fa:IconImage Icon="Receipt" Foreground="{StaticResource BrushTextMuted}" Width="12" Height="12"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- RIGHT: STOCK TO REVIEW CARD -->
                    <Border Grid.Column="1"
                            Background="{StaticResource BrushCardWhite}"
                            BorderBrush="{StaticResource BrushBorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Margin="5"
                            Padding="20">
                        <Border.Effect>
                            <DropShadowEffect Color="#172033" BlurRadius="14" ShadowDepth="2" Opacity="0.04"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Title Header -->
                                <RowDefinition Height="*"/>    <!-- Data Items List -->
                            </Grid.RowDefinitions>

                            <!-- Section Header -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                                <TextBlock Text="INVENTORY"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextMuted}"/>
                                <TextBlock Text="Stock to review"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource BrushTitleText}"
                                           Margin="0,2,0,1"/>
                                <TextBlock Text="Items running low or requiring immediate reorder."
                                           FontSize="12"
                                           Foreground="{StaticResource BrushTextMuted}"/>
                            </StackPanel>

                            <!-- Items to Review List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding CriticalItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BrushBorderSubtle}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="2,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Product Icon Badge -->
                                                    <Border Grid.Column="0"
                                                            Width="36" Height="36"
                                                            CornerRadius="8"
                                                            Background="#F1F5F9"
                                                            Margin="0,0,12,0">
                                                        <fa:IconImage Icon="Box" Foreground="#64748B" Width="16" Height="16"/>
                                                    </Border>

                                                    <!-- Product Name & Category -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource BrushTitleText}"
                                                                   FontSize="13.5"/>
                                                        <TextBlock Text="{Binding Category}"
                                                                   FontSize="11.5"
                                                                   Foreground="{StaticResource BrushTextMuted}"
                                                                   Margin="0,1,0,0"/>
                                                    </StackPanel>

                                                    <!-- Pill: "1 left" -->
                                                    <Border Grid.Column="2"
                                                            Background="#FEF2F2"
                                                            BorderBrush="#FECACA"
                                                            BorderThickness="1"
                                                            CornerRadius="10"
                                                            Padding="10,4"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Quantity, StringFormat='{}{0} left'}"
                                                                   FontSize="11.5"
                                                                   FontWeight="Bold"
                                                                   Foreground="#DC2626"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
